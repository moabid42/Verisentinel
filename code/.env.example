# Copy values into the ignored code/.env file.

# --- Backend selection ---------------------------------------------------------
# false (default): Google AI Studio (Gemini Developer API) via GEMINI_API_KEY.
#                  Runs on the free tier of whatever project minted the key.
# true          : Vertex AI on your GCP project via ADC. Usage bills to the project
#                  (covered by the $300 free-trial credit). Requires
#                  `gcloud auth application-default login` and aiplatform.googleapis.com
#                  enabled; GEMINI_API_KEY is then ignored.
GEMINI_USE_VERTEX=false
GOOGLE_CLOUD_PROJECT=              # required when GEMINI_USE_VERTEX=true (the target project)
GOOGLE_CLOUD_LOCATION=global       # Vertex region for Gemini; `global` or e.g. us-central1

GEMINI_API_KEY=                    # required only when GEMINI_USE_VERTEX=false
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.1-flash-lite
GEMINI_API_MODE=generate_content
GEMINI_THINKING_LEVEL=medium
GEMINI_TIMEOUT_SECONDS=120
GEMINI_MAX_ATTEMPTS=3
GEMINI_HEARTBEAT_SECONDS=10
GEMINI_FORCE_IPV4=true

# Required when scenario.yaml enables the full DSH Web copilot.
DSH_HOME=
DSH_SOURCE_ROOT=

# Optional path overrides.
# IAM_DATASET_PATH=/absolute/path/to/data/iam-dataset/gcp
# IAMOUFLAGE_DATA_PATH=/absolute/path/to/code/IAMouflage/code/data
# IAM_PLANNER_RUNTIME=/absolute/path/to/runtime
